        <script><![CDATA[(function executeRule(current, previous) {
    var policyId = current.getValue('policy');
    if (!policyId) {
        gs.addErrorMessage('A policy must be specified for the claim');
        current.setAbortAction(true);
        return;
    }

    var policy = new GlideRecord('x_1966159_insure_0_policy');
    if (policy.get(policyId)) {
        var status = policy.getValue('status');
        if (status !== 'active') {
            gs.addErrorMessage('Claims can only be submitted against active policies. The selected policy has status: ' + status);
            current.setAbortAction(true);
        }
    } else {
        gs.addErrorMessage('The referenced policy could not be found');
        current.setAbortAction(true);
    }
})(current, previous);
]]></script>
